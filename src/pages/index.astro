---
import Base from '../layouts/Base.astro';
import Tool from '../components/Tool.astro';
import AdSlot from '../components/AdSlot.astro';
import Article from '../components/Article.astro';
import Faq from '../components/Faq.astro';
import site from '../site.config.ts';
import { faq } from '../data/faq.ts';
import { url } from '../lib/url.ts';

const base = site.canonicalBase;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: site.name,
    url: `${base}/`,
    description: site.description,
    applicationCategory: site.category,
    featureList: 'T1, T2 and T3 stages, pass and fail progression, plates per side, session log, printable week, lb and kg',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    inLanguage: site.locale,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    author: { '@type': 'Person', name: 'Abhishek Mishra', jobTitle: 'Software Development Engineer', worksFor: { '@type': 'Organization', name: 'Oqu AI' }, url: 'https://bingemind.com/abhishek-mishra/' },
    publisher: { '@type': 'Organization', name: 'Bingemind', url: 'https://bingemind.com/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ '@type': 'ListItem', position: 1, name: site.name, item: `${base}/` }],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base jsonLd={jsonLd}>
  <section class="mx-auto max-w-5xl px-4 pt-10 sm:pt-16">
    <h1 class="max-w-3xl text-3xl font-extrabold leading-[1.05] tracking-tight [text-wrap:balance] sm:text-6xl">
      {site.h1}
    </h1>
    <p class="mt-4 hidden max-w-2xl text-lg text-muted sm:block">{site.description}</p>
    <div class="tool-wrap mt-5 sm:mt-8"><Tool /></div>
    <AdSlot />
  </section>
  <Article />
  <Faq />
</Base>
