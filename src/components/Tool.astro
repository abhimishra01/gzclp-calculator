---
// GZCLP planner UI. Rules live in src/lib/gzclp.js (tested by npm test). Plates use src/lib/plates.js.
---
<section id="tool" aria-label="GZCLP planner" class="rounded-2xl border border-line bg-card p-4 sm:p-6 sm:shadow-[6px_6px_0_0_var(--line)]">
  <noscript><p class="mb-4 rounded-xl bg-brand-soft p-3 text-sm">This planner needs JavaScript. The tables below the tool list every stage and rule, so you can follow the program on paper.</p></noscript>
  <div class="flex flex-col gap-8 md:grid md:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] md:items-start md:gap-8">

    <!-- Session -->
    <div class="no-print min-w-0">
      <fieldset>
        <legend class="mb-2 text-sm font-semibold">Next workout</legend>
        <div class="grid grid-cols-4 gap-2" id="day-group"></div>
      </fieldset>
      <p id="sample-note" class="mt-3 hidden rounded-xl bg-brand-soft p-3 text-sm">These are sample starting weights. <a href="#setup" class="alt-btn mt-2 inline-flex items-center">Set my weights</a></p>
      <h2 id="session-h" class="mt-5 text-sm font-semibold">Today's session</h2>
      <div id="session" class="mt-2 space-y-3 min-h-[34rem] md:min-h-[30rem]"></div>
      <div class="g-logbar mt-4">
        <button type="button" id="log-btn" class="g-primary">Log this session</button>
        <p id="log-status" role="status" aria-live="polite" class="mt-2 min-h-[1.25rem] text-sm text-muted"></p>
      </div>
      <h2 class="mt-6 text-sm font-semibold">Session log</h2>
      <ol id="log" class="mt-2 space-y-2 text-sm"></ol>
      <div class="mt-3 flex flex-wrap gap-2">
        <button type="button" id="undo-btn" class="alt-btn">Undo last session</button>
        <button type="button" id="clear-btn" class="alt-btn">Clear log</button>
      </div>
    </div>

    <!-- Setup -->
    <div id="setup" class="no-print min-w-0 space-y-5 scroll-mt-20">
      <h2 class="text-sm font-semibold">Your program</h2>
      <fieldset>
        <legend class="mb-2 text-sm font-semibold">Units</legend>
        <div class="grid grid-cols-2 gap-2" id="unit-group">
          <label class="seg"><input type="radio" name="unit" value="lb" class="peer sr-only" checked /><span class="seg-face">Pounds (lb)</span></label>
          <label class="seg"><input type="radio" name="unit" value="kg" class="peer sr-only" /><span class="seg-face">Kilograms (kg)</span></label>
        </div>
      </fieldset>
      <p id="setup-err" role="alert" class="min-h-0 text-sm font-semibold text-red-700 dark:text-red-400"></p>
      <p class="text-sm text-muted">Switching units rounds every weight to the nearest 5 lb or 2.5 kg, so a round trip can change a weight by a step.</p>
      <p class="text-sm text-muted">Type the weight you will lift next time. T1 starts near your 5-rep max (85 percent is common). T2 starts at a weight you could lift for 10 reps with a few to spare. T3 starts at a weight you can lift for 15 or more reps.</p>
      <div id="lifts" class="space-y-4"></div>
      <fieldset>
        <legend class="mb-2 text-sm font-semibold">Bar</legend>
        <div class="flex flex-wrap gap-2" id="bar-group"></div>
      </fieldset>
      <fieldset>
        <legend class="mb-1 text-sm font-semibold">Plates you have</legend>
        <p class="mb-2 text-sm text-muted">Tap to turn a plate off.</p>
        <div id="plate-group" class="flex flex-wrap gap-2"></div>
      </fieldset>
      <button type="button" id="print-btn" class="alt-btn">Print the four-day cycle</button>
    </div>
  </div>

  <div id="print-week" aria-hidden="true"></div>
</section>

<style is:global>
  .seg-face { display:flex; flex-direction:column; min-height:3rem; align-items:center; justify-content:center; border-radius:.75rem; border:1px solid var(--edge); background:var(--paper); padding:.4rem .6rem; font-weight:600; font-size:.95rem; cursor:pointer; text-align:center; transition:background-color .12s,border-color .12s; user-select:none; line-height:1.15; }
  .seg-face small { display:block; font-weight:500; font-size:.72rem; opacity:.85; }
  .seg-face:hover { border-color: var(--brand); }
  .peer:checked + .seg-face { background: var(--brand); border-color: var(--brand); color:#fff; }
  .peer:focus-visible + .seg-face, .peer:focus-visible + .plate-pill { outline:2px solid var(--brand-ink); outline-offset:2px; }
  .step { width:3.25rem; flex:none; min-height:3rem; border-radius:.75rem; border:1px solid var(--edge); background:var(--paper); font-size:1.5rem; font-weight:600; line-height:1; cursor:pointer; }
  .step:hover { border-color: var(--brand); }
  .step:active { background: var(--brand-soft); }
  .plate-pill { display:flex; min-height:3rem; align-items:center; border-radius:.75rem; border:1px solid var(--edge); background:var(--paper); padding:.35rem .85rem; font-weight:600; font-size:.95rem; cursor:pointer; user-select:none; font-variant-numeric:tabular-nums; }
  .peer:not(:checked) + .plate-pill { opacity:.72; text-decoration:line-through; text-decoration-color: var(--muted); }
  .peer:checked + .plate-pill { border-color: var(--brand); box-shadow: inset 0 0 0 1px var(--brand); }
  .alt-btn { min-height:2.75rem; padding:.4rem .9rem; border-radius:.75rem; border:1px solid var(--brand); background:var(--card); font-weight:600; font-size:.95rem; color:var(--brand-ink); cursor:pointer; }
  .alt-btn:hover { background: var(--brand); color:#fff; }
  .alt-btn:disabled { opacity:.5; cursor:not-allowed; }
  .alt-btn:disabled:hover { background: var(--card); color: var(--brand-ink); }
  .g-primary { width:100%; min-height:3.5rem; border-radius:.75rem; border:1px solid var(--brand); background:var(--brand); color:#fff; font-weight:700; font-size:1.1rem; cursor:pointer; }
  .g-primary:hover { filter:brightness(1.08); }
  .g-logbar { position:sticky; bottom:.5rem; z-index:5; padding:.5rem; margin:0 -.5rem; border-radius:1rem; background:var(--card); }
  @media (min-width: 768px) { .g-logbar { position:static; padding:0; margin:1rem 0 0; background:none; } }

  .g-card { border:1px solid var(--line); border-radius:.9rem; background:var(--paper); padding:.85rem 1rem; }
  .g-head { display:flex; flex-wrap:wrap; align-items:baseline; gap:.5rem; }
  .g-tier { display:inline-block; min-width:2rem; text-align:center; border-radius:.4rem; background:var(--brand); color:#fff; font-size:.75rem; font-weight:800; padding:.1rem .4rem; letter-spacing:.04em; }
  .g-name { font-size:1.1rem; font-weight:700; }
  .g-rest { margin-left:auto; font-size:.8rem; color:var(--muted); }
  .g-main { margin-top:.25rem; font-size:1.5rem; font-weight:800; font-variant-numeric:tabular-nums; line-height:1.2; }
  .g-main span { font-weight:600; font-size:1rem; color:var(--muted); }
  .g-side { margin-top:.1rem; font-size:.95rem; color:var(--muted); font-variant-numeric:tabular-nums; }
  .g-res { display:grid; grid-template-columns:1fr 1fr; gap:.5rem; margin-top:.6rem; }
  .g-reps { display:flex; align-items:stretch; gap:.5rem; margin-top:.6rem; }
  .g-reps input { height:3rem; width:5rem; border-radius:.75rem; border:1px solid var(--edge); background:var(--card); text-align:center; font-family:ui-monospace,Menlo,Consolas,monospace; font-size:1.25rem; font-weight:700; }
  .g-reps label { align-self:center; font-size:.9rem; font-weight:600; margin-right:auto; }
  .g-next { margin-top:.6rem; font-size:.95rem; font-weight:600; }
  .g-alt { margin-top:.1rem; font-size:.85rem; color:var(--muted); }
  .g-field { display:grid; grid-template-columns:4.5rem 1fr 1fr; gap:.5rem; align-items:center; }
  .g-field[hidden] { display:none; }
  .g-field > span { font-size:.85rem; color:var(--muted); font-weight:600; }
  .g-in { height:3rem; width:100%; min-width:0; border-radius:.75rem; border:1px solid var(--edge); background:var(--paper); padding:0 .6rem; font-size:1.05rem; font-weight:600; font-variant-numeric:tabular-nums; }
  .g-in[aria-invalid="true"] { border-color:#dc2626; }
  .g-in:focus { outline:2px solid var(--brand-ink); outline-offset:1px; }
  .g-lift { border:1px solid var(--line); border-radius:.9rem; padding:.7rem .8rem .8rem; }
  .g-lift legend { padding:0 .35rem; font-weight:700; font-size:.95rem; }
  .g-lift .g-field + .g-field { margin-top:.5rem; }
  .g-log { border-left:3px solid var(--line); padding:.15rem 0 .15rem .7rem; }
  .g-log b { font-weight:700; }

  #print-week { display:none; }
  .g-in[aria-invalid="true"], :root[data-skin="retro"][data-theme] .g-in[aria-invalid="true"] { border-color:#dc2626; }
  @media print {
    header, footer, .no-print, main > section:not(:first-child), main > article, a.sr-only { display:none !important; }
    main > section:first-child > :not(.tool-wrap) { display:none !important; }
    #tool { border:0 !important; box-shadow:none !important; background:none !important; padding:0 !important; }
    #tool > :not(#print-week) { display:none !important; }
    #print-week { display:block !important; color:#000; font-family:ui-sans-serif,system-ui,sans-serif; }
    #print-week h2 { font-size:18pt; margin:0 0 4pt; }
    #print-week h3 { font-size:13pt; margin:14pt 0 4pt; }
    #print-week table { width:100%; border-collapse:collapse; font-size:11pt; }
    #print-week th, #print-week td { border:1px solid #000; padding:5pt 6pt; text-align:left; }
    #print-week .box { font-size:15pt; letter-spacing:3pt; }
    #print-week p { font-size:10pt; margin:4pt 0; }
    body, html { background:#fff !important; }
    body::before { display:none !important; }
  }
</style>
<script>
  import { DAYS, LIFTS, MAIN, ACCESSORY, SCHEMES, MAX_WEIGHT, T3_BUMP_REPS, sessionFor, schemeText, progress, resetHint, upcoming, fromFiveRM, convertState, fmt, slotKey } from '../lib/gzclp.js';
  import { PLATES, BARS, solve, parseNumber } from '../lib/plates.js';
  import { STORE_KEY, loadStore, logSession, undoSession } from '../lib/store.js';

  type Unit = 'lb' | 'kg';
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const esc = (t: unknown) => String(t).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  let saved: string | null = null;
  try { saved = localStorage.getItem(STORE_KEY); } catch {}
  let { state, log }: { state: any; log: any[] } = loadStore(saved);
  const isNum = (x: unknown): x is number => typeof x === 'number' && Number.isFinite(x) && x >= 1 && x <= MAX_WEIGHT[state.unit as Unit];
  const save = () => { try { localStorage.setItem(STORE_KEY, JSON.stringify({ state, log })); } catch {} };

  const picks: Record<string, 'pass' | 'fail'> = {};
  const reps: Record<string, number> = {};
  const unitOf = () => state.unit as Unit;

  const sideText = (weight: number, lift: string) => {
    if (ACCESSORY.includes(lift)) return ''; // machine and dumbbell lifts have no plates per side
    const u = unitOf();
    const bar = state.prefs.bar[u];
    const r: any = solve({ target: weight, bar, plates: state.prefs.plates[u] });
    if (r.status === 'bar') return 'Bar only';
    if (r.status === 'below') return `Lighter than the ${fmt(bar)} ${u} bar`;
    if (r.status === 'empty') return '';
    const txt = r.list.map((p: any) => (p.n > 1 ? `${p.n} × ${fmt(p.w)}` : fmt(p.w))).join(' + ');
    if (!txt) return 'Turn on a plate size';
    return r.status === 'exact' ? `Each side: ${txt}` : `Each side: ${txt} (closest load is ${fmt(r.total)} ${u})`;
  };
  const outcome = (tier: string, lift: string, slot: any, input: any) => {
    const u = unitOf();
    const n: any = progress(tier, lift, slot, input, u);
    const scheme = schemeText(SCHEMES[tier][n.stage]);
    return `${fmt(n.weight)} ${u}, ${scheme}${n.reset ? ` (${resetHint(tier, u)})` : ''}`;
  };

  function buildDays() {
    $('day-group').innerHTML = DAYS.map((d, i) =>
      `<label class="seg"><input type="radio" name="day" value="${i}" class="peer sr-only"${i === state.day ? ' checked' : ''} /><span class="seg-face">Day ${d.id}<small>${LIFTS[d.t1].name.split(' ')[0]}</small></span></label>`).join('');
  }

  function renderSession() {
    const u = unitOf();
    $('sample-note').classList.toggle('hidden', state.touched);
    $('session').innerHTML = sessionFor(state, state.day).map((it: any) => {
      const slot = state.slots[it.key];
      const side = sideText(it.weight, it.lift);
      const head = `<div class="g-head"><span class="g-tier">${it.tier.toUpperCase()}</span><h3 class="g-name">${it.name}</h3><span class="g-rest">Rest ${it.rest}</span></div>
        <p class="g-main">${schemeText(it)} <span>at</span> ${fmt(it.weight)} <span>${u}</span></p>${side ? `<p class="g-side">${side}</p>` : ''}`;
      if (it.tier === 't3') {
        const r = reps[it.key] ?? 15;
        const bump = r >= T3_BUMP_REPS;
        return `<article class="g-card" data-key="${it.key}">${head}
          <div class="g-reps"><label for="reps-${it.key}">Reps on the last set</label>
            <button type="button" class="step" data-act="rdec" aria-label="One fewer rep on the last set of ${it.name}">&minus;</button>
            <input id="reps-${it.key}" type="text" inputmode="numeric" autocomplete="off" value="${r}" data-reps="${it.key}" />
            <button type="button" class="step" data-act="rinc" aria-label="One more rep on the last set of ${it.name}">+</button></div>
          <p class="g-next" aria-live="polite">Next time: ${bump ? outcome('t3', it.lift, slot, { reps: r }) : `${fmt(it.weight)} ${u}, same weight`}</p>
          <p class="g-alt">${T3_BUMP_REPS} or more reps on the last set adds weight. Less keeps it the same.</p></article>`;
      }
      const pick = picks[it.key] || 'pass';
      const pass = outcome(it.tier, it.lift, slot, { pass: true });
      const fail = outcome(it.tier, it.lift, slot, { pass: false });
      const need = it.tier === 't1' ? `at least ${it.reps} ${it.reps === 1 ? 'rep' : 'reps'} on every set` : `all ${it.reps} reps on every set`;
      return `<article class="g-card" data-key="${it.key}">${head}
        <fieldset class="g-res"><legend class="sr-only">Result for ${it.name}</legend>
          <label class="seg"><input type="radio" name="res-${it.key}" value="pass" class="peer sr-only"${pick === 'pass' ? ' checked' : ''} /><span class="seg-face">Pass<small>${need}</small></span></label>
          <label class="seg"><input type="radio" name="res-${it.key}" value="fail" class="peer sr-only"${pick === 'fail' ? ' checked' : ''} /><span class="seg-face">Fail<small>any set below the target</small></span></label>
        </fieldset>
        <p class="g-next" aria-live="polite">Next time: ${pick === 'pass' ? pass : fail}</p>
        <p class="g-alt">${pick === 'pass' ? `If you fail: ${fail}` : `If you pass: ${pass}`}</p></article>`;
    }).join('');
  }

  const lifts = [...MAIN, ...ACCESSORY];
  function buildSetup() {
    const u = unitOf();
    (document.querySelector(`input[name=unit][value=${u}]`) as HTMLInputElement).checked = true;
    const stageOpts = (tier: string, cur: number) => SCHEMES[tier].map((s: any, i: number) => `<option value="${i}"${i === cur ? ' selected' : ''}>${i + 1}: ${schemeText(s)}</option>`).join('');
    $('lifts').innerHTML = lifts.map((lift) => {
      if (MAIN.includes(lift)) {
        const a = state.slots[slotKey('t1', lift)], b = state.slots[slotKey('t2', lift)];
        return `<fieldset class="g-lift"><legend>${LIFTS[lift].name}</legend>
          <div class="g-field"><span>T1 (${u})</span><input class="g-in" type="text" inputmode="decimal" autocomplete="off" data-w="t1.${lift}" aria-label="${LIFTS[lift].name} T1 weight in ${u}" value="${fmt(a.weight)}" /><select class="g-in" data-stage="t1.${lift}" aria-label="${LIFTS[lift].name} T1 stage (1 is the first stage)">${stageOpts('t1', a.stage)}</select></div>
          <div class="g-field"><span>T2 (${u})</span><input class="g-in" type="text" inputmode="decimal" autocomplete="off" data-w="t2.${lift}" aria-label="${LIFTS[lift].name} T2 weight in ${u}" value="${fmt(b.weight)}" /><select class="g-in" data-stage="t2.${lift}" aria-label="${LIFTS[lift].name} T2 stage">${stageOpts('t2', b.stage)}</select></div>
          <div class="g-field" data-base-row="t2.${lift}"${b.stage > 0 ? '' : ' hidden'}><span>Base</span><input class="g-in" type="text" inputmode="decimal" autocomplete="off" data-base="t2.${lift}" aria-label="${LIFTS[lift].name} T2 last weight you lifted for 3 × 10, in ${u}" value="${fmt(b.base)}" /><span>last 3 × 10 weight</span></div>
          <div class="g-field"><span>5RM</span><input class="g-in" type="text" inputmode="decimal" autocomplete="off" data-rm="${lift}" aria-label="${LIFTS[lift].name} 5-rep max in ${u}, sets T1 to 85 percent" placeholder="Optional" /><span>sets T1 to 85%</span></div></fieldset>`;
      }
      const s = state.slots[lift];
      return `<fieldset class="g-lift"><legend>${LIFTS[lift].name} (T3)</legend>
        <div class="g-field"><span>Weight (${u})</span><input class="g-in" type="text" inputmode="decimal" autocomplete="off" data-w="${lift}" aria-label="${LIFTS[lift].name} weight in ${u}" value="${fmt(s.weight)}" /><span>3 × 15+</span></div></fieldset>`;
    }).join('');
    const bars = BARS[u] as number[];
    $('bar-group').innerHTML = bars.map((b) => `<label class="seg"><input type="radio" name="bar" value="${b}" class="peer sr-only"${b === state.prefs.bar[u] ? ' checked' : ''} /><span class="seg-face">${b} ${u}</span></label>`).join('');
    $('plate-group').innerHTML = (PLATES[u] as number[]).map((w) =>
      `<label><input type="checkbox" name="plate" value="${w}" class="peer sr-only"${state.prefs.plates[u].includes(w) ? ' checked' : ''} /><span class="plate-pill">${fmt(w)} ${u}</span></label>`).join('');
  }

  const dayLine = (e: any) => e.items.map((x: any) => `${esc(x.name)} ${fmt(x.weight)} ${e.unit}, ${x.tier === 't3' ? `${x.reps} reps` : x.pass ? 'pass' : 'fail'}`).join('; ');
  function renderLog() {
    $('log').innerHTML = log.length
      ? log.slice(0, 6).map((e) => `<li class="g-log"><b>${esc(e.date)}, Day ${DAYS[e.prevDay].id}.</b> ${dayLine(e)}</li>`).join('')
      : '<li class="text-muted">No sessions logged yet. Pick pass or fail for each lift, then press Log this session.</li>';
    ($('undo-btn') as HTMLButtonElement).disabled = log.length === 0;
    ($('clear-btn') as HTMLButtonElement).disabled = log.length === 0;
  }
  const renderAll = () => { buildDays(); renderSession(); renderLog(); save(); };

  // Events
  $('day-group').addEventListener('change', (e) => { state.day = Number((e.target as HTMLInputElement).value); renderSession(); save(); });
  $('session').addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name.startsWith('res-')) { picks[t.name.slice(4)] = t.value as 'pass' | 'fail'; renderSession(); (document.querySelector(`input[name="${t.name}"]:checked`) as HTMLElement | null)?.focus(); }
  });
  $('session').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button[data-act]') as HTMLElement | null;
    if (!b) return;
    const key = b.closest('article')!.dataset.key!;
    reps[key] = Math.max(0, Math.min(99, (reps[key] ?? 15) + (b.dataset.act === 'rinc' ? 1 : -1)));
    renderSession();
    (document.querySelector(`[data-key="${key}"] [data-act="${b.dataset.act}"]`) as HTMLElement | null)?.focus();
  });
  $('session').addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (!t.dataset.reps) return;
    const v = parseInt(t.value, 10);
    if (Number.isFinite(v) && v >= 0 && v <= 99) {
      reps[t.dataset.reps] = v;
      const art = t.closest('article')!;
      const slot = state.slots[t.dataset.reps];
      art.querySelector('.g-next')!.textContent = `Next time: ${v >= T3_BUMP_REPS ? outcome('t3', t.dataset.reps, slot, { reps: v }) : `${fmt(slot.weight)} ${unitOf()}, same weight`}`;
    }
  });

  $('log-btn').addEventListener('click', () => {
    const results: Record<string, any> = {};
    for (const it of sessionFor(state, state.day) as any[]) {
      if (it.tier !== 't3') { results[it.key] = { pass: (picks[it.key] || 'pass') === 'pass' }; continue; }
      const box = document.getElementById(`reps-${it.key}`) as HTMLInputElement | null;
      const v = box && /^\d{1,2}$/.test(box.value.trim()) ? Number(box.value.trim()) : NaN;
      if (!Number.isFinite(v)) { $('log-status').textContent = `Enter the reps you did on the last set of ${it.name}.`; box?.focus(); return; }
      results[it.key] = { reps: v };
    }
    const done = logSession({ state, log }, results, new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric' }));
    ({ state, log } = done.store);
    for (const k of Object.keys(picks)) delete picks[k];
    for (const k of Object.keys(reps)) delete reps[k];
    buildSetup(); renderAll();
    const resets = done.items.filter((x: any) => x.reset).map((x: any) => x.name);
    $('log-status').textContent = `Session logged. Next up: Day ${DAYS[state.day].id}.${resets.length ? ` Reset for ${resets.join(', ')}.` : ''}`;
  });
  $('undo-btn').addEventListener('click', () => {
    if (!log.length) return;
    ({ state, log } = undoSession({ state, log }));
    buildSetup(); renderAll();
    $('log-status').textContent = 'Last session undone.';
  });
  $('clear-btn').addEventListener('click', () => {
    if (!confirm('Clear the whole session log? Your current weights stay.')) return;
    log = []; renderAll(); $('log-status').textContent = 'Log cleared.';
  });

  $('unit-group').addEventListener('change', (e) => {
    state = convertState(state, (e.target as HTMLInputElement).value as Unit);
    buildSetup(); renderAll();
  });
  $('bar-group').addEventListener('change', (e) => { state.prefs.bar[unitOf()] = Number((e.target as HTMLInputElement).value); renderSession(); save(); });
  $('plate-group').addEventListener('change', () => {
    state.prefs.plates[unitOf()] = Array.from(document.querySelectorAll<HTMLInputElement>('input[name=plate]:checked')).map((i) => Number(i.value));
    renderSession(); save();
  });

  const setup = $('setup');
  const showErr = (msg: string) => { $('setup-err').textContent = msg; };
  setup.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.dataset.w) {
      const v = parseNumber(t.value);
      const ok = isNum(v);
      t.setAttribute('aria-invalid', String(!ok));
      showErr(ok ? '' : `Enter a weight from 1 to ${MAX_WEIGHT[unitOf()]} ${unitOf()}.`);
      if (!ok) return;
      const s = state.slots[t.dataset.w];
      s.weight = v; if (s.stage === 0 || s.base > v) s.base = v;
      const baseBox = setup.querySelector(`[data-base="${t.dataset.w}"]`) as HTMLInputElement | null;
      if (baseBox) baseBox.value = fmt(s.base);
      state.touched = true; renderSession(); save();
    } else if (t.dataset.base) {
      const v = parseNumber(t.value);
      const s = state.slots[t.dataset.base];
      const ok = isNum(v) && v <= s.weight;
      t.setAttribute('aria-invalid', String(!ok));
      showErr(ok ? '' : `Enter the last 3 × 10 weight: from 1 up to ${fmt(s.weight)} ${unitOf()}.`);
      if (!ok) return;
      s.base = v; state.touched = true; renderSession(); save();
    } else if (t.dataset.rm) {
      const v = parseNumber(t.value);
      const bad = t.value.trim() !== '' && !isNum(v);
      t.setAttribute('aria-invalid', String(bad));
      showErr(bad ? `Enter a 5-rep max from 1 to ${MAX_WEIGHT[unitOf()]} ${unitOf()}.` : '');
      if (!isNum(v)) return;
      const w = fromFiveRM(v, unitOf());
      const s = state.slots[`t1.${t.dataset.rm}`];
      s.weight = w; s.stage = 0; s.base = w;
      (setup.querySelector(`[data-w="t1.${t.dataset.rm}"]`) as HTMLInputElement).value = fmt(w);
      (setup.querySelector(`[data-stage="t1.${t.dataset.rm}"]`) as HTMLSelectElement).value = '0';
      state.touched = true; renderSession(); save();
    }
  });
  setup.addEventListener('change', (e) => {
    const t = e.target as HTMLSelectElement;
    if (!t.dataset.stage) return;
    const s = state.slots[t.dataset.stage];
    s.stage = Number(t.value); if (s.stage === 0) s.base = s.weight;
    const row = setup.querySelector(`[data-base-row="${t.dataset.stage}"]`) as HTMLElement | null;
    if (row) {
      row.hidden = s.stage === 0;
      (row.querySelector('input') as HTMLInputElement).value = fmt(s.base);
      if (s.stage > 0) (row.querySelector('input') as HTMLInputElement).focus();
    }
    state.touched = true; renderSession(); save();
  });
  setup.addEventListener('focusout', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.dataset.w) { t.value = fmt(state.slots[t.dataset.w].weight); t.removeAttribute('aria-invalid'); }
    if (t.dataset.base) { t.value = fmt(state.slots[t.dataset.base].base); t.removeAttribute('aria-invalid'); }
    if (t.dataset.rm && t.value.trim() === '') t.removeAttribute('aria-invalid');
    showErr('');
  });
  $('session').addEventListener('focusout', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.dataset.reps) t.value = String(reps[t.dataset.reps] ?? 15); // an empty or bad box goes back to the number in use
  });

  // Print: the four-day cycle at today's weights, with a tick box for each set.
  $('print-btn').addEventListener('click', () => {
    const u = unitOf();
    const rows = (items: any[]) => items.map((it) => `<tr><td>${it.tier.toUpperCase()}</td><td>${it.name}</td><td>${schemeText(it)}</td><td>${fmt(it.weight)} ${u}</td><td>${sideText(it.weight, it.lift).replace('Each side: ', '') || 'n/a'}</td><td class="box">${'□'.repeat(it.sets)}</td></tr>`).join('');
    $('print-week').innerHTML = `<h2>GZCLP: four-day cycle</h2>
      <p>Printed ${new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}. Weights in ${u}, as of today. Weights go up after each pass, so update them as you log. A "+" means the last set is as many reps as you can do, with 1 or 2 reps left in reserve.</p>
      ${upcoming(state, 4).map((s: any) => `<h3>Day ${DAYS[s.day].id}</h3><table><thead><tr><th>Tier</th><th>Lift</th><th>Sets × reps</th><th>Weight</th><th>Each side</th><th>Done</th></tr></thead><tbody>${rows(s.items)}</tbody></table>`).join('')}
      <p>Pass T1: at least the target reps on every set. Pass T2: every rep of every set. T3: ${T3_BUMP_REPS} or more reps on the last set adds weight. Not medical advice.</p>`;
    window.print();
  });

  buildSetup();
  renderAll();
</script>
